// Read-mostly filesystem namespace delegated to one process or domain.
// Relative paths supplied here are resolved from the store root. Directory
// handles provide directory-relative traversal.
interface IFileStore {
    uuid auto;
    requires IGenericObject;

    method FacetResult open_file(in string path, out handle file);
    method FacetResult open_directory(in string path, out handle directory);
}

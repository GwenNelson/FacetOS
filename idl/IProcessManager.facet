// Privileged process construction service.  Callers supply only a path and
// receive no platform-specific process state.
interface IProcessManager {
    uuid auto;
    requires IGenericObject;

    method FacetResult launch(in string path, in array<string> argv,
                              in handle environment, out handle process);

    // Bootstrap-only entry point. Possession of a domain's process manager is
    // the authority to start its configured initial program; unlike launch(),
    // this does not pretend that an IDomainEnvironment is an authenticated
    // process environment.
    method FacetResult launch_initial(in string path, in array<string> argv,
                                      out handle process);
}

// Configuration used when creating or launching a domain.
//
// The UUID is intentionally generated for this provisional interface. Assign
// an explicit UUID before persisting this interface as an ABI.
interface IDomainConfig {
    uuid auto;
    requires IGenericObject;
    requires ILoggingConfig;
    requires IDomainConsoleConfig;

    enum Personality : u32 {
        Native = 0;
        Posix = 1;
        Vm = 2;
    };

    enum DomainManagerMode : u32 {
        None = 0;
        Local = 1;
        Parent = 2;
    };

    property u64 domain_id read;
    property string domain_name read;
    // Empty for native domains. POSIX dominit uses this as its first process.
    property string pid1 read;
    property Personality personality read;
    // Object-valued properties are capability attachments on the wire.
    property handle logger_config read;
    property handle console_config read;
    property DomainManagerMode domain_manager read;
}

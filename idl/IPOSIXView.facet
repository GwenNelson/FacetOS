// Provisional per-process POSIX translation view. Transport status and POSIX
// result/errno are deliberately separate.
interface IPOSIXView {
    uuid auto;
    requires IGenericObject;

    method FacetResult write_fd(in i32 fd, in array<u8> data,
                                out i64 result, out i32 error);
    method FacetResult read_fd(in i32 fd, in u32 maximum,
                               out array<u8> data, out i64 result,
                               out i32 error);
    method FacetResult open_fd(in string path, in i32 flags, in u32 mode,
                               out i32 fd, out i32 error);
    method FacetResult close_fd(in i32 fd, out i32 result, out i32 error);
    method FacetResult seek_fd(in i32 fd, in i64 offset, in i32 whence,
                               out i64 result, out i32 error);
    method FacetResult allocate_pages(in u64 count, out local_ptr pages);
    method FacetResult free_pages(in u64 count, in u64 base);
    method FacetResult exit_process(in i32 status);
    // FacetOS POSIX-view extensions. They deliberately keep all native
    // authority behind this per-process translation object.
    method FacetResult get_domain_id(out u64 domain_id);
    method FacetResult get_pid(out i32 pid);
    // libc implements the standard setuid/setgid calls through this narrow
    // per-process transition; applications never receive native auth state.
    method FacetResult set_credentials(in u32 uid, in u32 gid,
                                      out i32 error);
    method FacetResult get_cwd(out string path, out i32 error);
    method FacetResult change_directory(in string path, out i32 error);
    method FacetResult list_directory(in string path, out array<string> entries,
                                     out i32 error);
    method FacetResult authenticate(in string username, in string password,
                                   out handle session, out i32 error);
    method FacetResult spawn_process(in string path, in array<string> argv,
                                    in handle session, out i32 pid,
                                    out i32 error);
    // Starts a child under the caller's inherited session.  This is separate
    // from spawn_process because a null capability cannot cross the seL4 IPC
    // capability-transfer boundary.
    method FacetResult spawn_inherited(in string path, in array<string> argv,
                                      out i32 pid, out i32 error);
    method FacetResult wait_process(in i32 pid, out i32 status, out i32 error);
    // Metadata used by libc stat(2).  The mode includes the standard file
    // type bits so applications do not need a FacetOS directory-entry ABI.
    method FacetResult stat_path(in string path, out u32 mode, out u32 uid,
                                 out u32 gid, out i32 error);
}

// Console assignment configuration for a domain.
//
interface IDomainConsoleConfig {
    uuid auto;
    requires IGenericObject;

    struct Assignment {
        string seat;
        string terminal;
        string view;
        string initial_process;
    };

    property array<Assignment> assignments read;
    property u64 assignment_count read;
    method FacetResult get_assignment(in u64 index, out Assignment assignment);
}

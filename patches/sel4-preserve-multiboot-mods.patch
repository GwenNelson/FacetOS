--- a/src/arch/x86/kernel/boot.c
+++ b/src/arch/x86/kernel/boot.c
@@ -26,6 +26,127 @@
 #define MAX_RESERVED 1
 BOOT_BSS static region_t reserved[MAX_RESERVED];
 
+typedef struct {
+    paddr_t start;
+    paddr_t end;
+    const char *name;
+} boot_module_info_t;
+
+BOOT_CODE static word_t multiboot_module_count(void)
+{
+    if (boot_state.multiboot_magic == MULTIBOOT_MAGIC) {
+        multiboot_info_t *mbi = boot_state.multiboot;
+        return mbi->part1.mod_count;
+    }
+
+    word_t count = 0;
+    multiboot2_header_t *mbi2 = boot_state.multiboot;
+    multiboot2_tag_t const *tag = (multiboot2_tag_t *)(mbi2 + 1);
+    multiboot2_tag_t const *tag_e = (multiboot2_tag_t *)((word_t)mbi2 + mbi2->total_size);
+    while (tag < tag_e && tag->type != MULTIBOOT2_TAG_END) {
+        if (tag->type == MULTIBOOT2_TAG_MODULE) {
+            count++;
+        }
+        tag = (multiboot2_tag_t const *)((word_t)tag + ROUND_UP(tag->size, 3));
+    }
+    return count;
+}
+
+BOOT_CODE static bool_t multiboot_module(word_t index, boot_module_info_t *module)
+{
+    if (boot_state.multiboot_magic == MULTIBOOT_MAGIC) {
+        multiboot_info_t *mbi = boot_state.multiboot;
+        multiboot_module_t *modules = (multiboot_module_t *)(word_t)mbi->part1.mod_list;
+        if (index >= mbi->part1.mod_count) {
+            return false;
+        }
+        module->start = modules[index].start;
+        module->end = modules[index].end;
+        module->name = (const char *)(word_t)modules[index].name;
+        return true;
+    }
+
+    multiboot2_header_t *mbi2 = boot_state.multiboot;
+    multiboot2_tag_t const *tag = (multiboot2_tag_t *)(mbi2 + 1);
+    multiboot2_tag_t const *tag_e = (multiboot2_tag_t const *)((word_t)mbi2 + mbi2->total_size);
+    word_t current = 0;
+    while (tag < tag_e && tag->type != MULTIBOOT2_TAG_END) {
+        if (tag->type == MULTIBOOT2_TAG_MODULE) {
+            if (current == index) {
+                multiboot2_module_t const *mb_module =
+                    (multiboot2_module_t const *)((word_t)tag + sizeof(*tag));
+                module->start = mb_module->start;
+                module->end = mb_module->end;
+                module->name = mb_module->string;
+                return true;
+            }
+            current++;
+        }
+        tag = (multiboot2_tag_t const *)((word_t)tag + ROUND_UP(tag->size, 3));
+    }
+    return false;
+}
+
+BOOT_CODE static word_t module_name_length(const char *name)
+{
+    word_t length = 0;
+    while (name[length] != '\0') {
+        length++;
+    }
+    return length;
+}
+
+BOOT_CODE static word_t multiboot_modules_bootinfo_size(void)
+{
+    word_t count = multiboot_module_count();
+    if (count <= 1) {
+        return 0;
+    }
+
+    word_t size = sizeof(seL4_BootInfoHeader) + sizeof(seL4_Word)
+                  + (count - 1) * sizeof(seL4_X86_BootInfo_module_t);
+    for (word_t i = 1; i < count; i++) {
+        boot_module_info_t module;
+        assert(multiboot_module(i, &module));
+        size += module_name_length(module.name) + 1;
+    }
+    return size;
+}
+
+BOOT_CODE static word_t populate_multiboot_modules(void *destination, ui_info_t ui_info)
+{
+    word_t count = multiboot_module_count();
+    if (count <= 1) {
+        return 0;
+    }
+
+    word_t size = multiboot_modules_bootinfo_size();
+    seL4_X86_BootInfo_modules_t *info = destination;
+    info->header.id = SEL4_BOOTINFO_HEADER_X86_MODULES;
+    info->header.len = size;
+    info->module_count = count - 1;
+
+    word_t module_data_vaddr = ui_info.p_reg.end - ui_info.pv_offset
+                                - (boot_state.mods_end_paddr - boot_state.boot_module_start);
+    word_t descriptor_offset = sizeof(*info);
+    word_t name_offset = descriptor_offset + (count - 1) * sizeof(seL4_X86_BootInfo_module_t);
+
+    for (word_t i = 1; i < count; i++) {
+        boot_module_info_t module;
+        assert(multiboot_module(i, &module));
+        seL4_X86_BootInfo_module_t *descriptor =
+            (seL4_X86_BootInfo_module_t *)((word_t)info + descriptor_offset);
+        descriptor->start = module_data_vaddr + module.start - boot_state.boot_module_start;
+        descriptor->size = module.end - module.start;
+        descriptor->name_offset = name_offset;
+        memcpy((void *)((word_t)info + name_offset), module.name, module_name_length(module.name) + 1);
+        descriptor_offset += sizeof(*descriptor);
+        name_offset += module_name_length(module.name) + 1;
+    }
+    assert(name_offset == size);
+    return size;
+}
